flowchart LR
  subgraph SCM["01 · GITLAB — SOURCE & ORCHESTRATION"]
    direction TB
    REPO["Git repository"]
    PIPE["CI pipeline"]
    RUNNER["GitLab Runner manager"]
    REPO --> PIPE --> RUNNER
  end
  subgraph CLUSTER["02 · AMAZON EKS — EPHEMERAL BUILD BOUNDARY"]
    direction TB
    API["Kubernetes API"]
    subgraph POD["Kubernetes job pod"]
      direction TB
      BUILD["Buildah · OCI build"]
      IMAGE["Image layers + digest"]
      BUILD --> IMAGE
    end
    SA["Kubernetes ServiceAccount"]
    API --> POD
    SA -. "Projected OIDC token" .-> BUILD
  end
  subgraph ACCOUNT["03 · AWS ACCOUNT — AUTHORIZATION & REGISTRY"]
    direction TB
    OIDC["IAM OIDC provider"]
    STS["AWS STS · AssumeRoleWithWebIdentity"]
    IAM["Scoped ECR push policy"]
    ECR[("Amazon ECR · image repository")]
    OIDC --> STS --> IAM
    IAM --> ECR
  end
  RUNNER -->|"Create job pod"| API
  SA -. "Federated identity" .-> OIDC
  BUILD -->|"Request short-lived credentials"| STS
  IMAGE -->|"Push layers and manifest"| ECR
  ECR -->|"Pull by digest"| DEPLOY["Downstream deployment"]
  classDef source fill:#E9F1FF,stroke:#2D63A8,stroke-width:2px,color:#12213A
  classDef execution fill:#E8F7F5,stroke:#148C7D,stroke-width:2px,color:#103B36
  classDef identity fill:#FFF3E5,stroke:#D68A26,stroke-width:2px,color:#573709
  classDef registry fill:#EDE9FE,stroke:#7C3AED,stroke-width:2px,color:#3B1D78
  class REPO,PIPE,RUNNER source
  class API,BUILD,IMAGE,DEPLOY execution
  class SA,OIDC,STS,IAM identity
  class ECR registry
  style SCM fill:#F7F9FC,stroke:#CBD5E1,stroke-width:2px
  style CLUSTER fill:#F2FAF8,stroke:#9ED5C9,stroke-width:2px
  style POD fill:#FFFFFF,stroke:#148C7D,stroke-dasharray:5 4
  style ACCOUNT fill:#FCF9F5,stroke:#E8CFAB,stroke-width:2px
